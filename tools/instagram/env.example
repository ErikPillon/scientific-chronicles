# Instagram auto-posting pipeline — secrets and settings.
#
# Copy to ~/.config/sc-instagram/env and chmod 600. Never commit this file.
#   mkdir -p ~/.config/sc-instagram
#   cp tools/instagram/env.example ~/.config/sc-instagram/env
#   chmod 600 ~/.config/sc-instagram/env

# ---- Telegram approval bot -------------------------------------------------
# Create a NEW bot in @BotFather (/newbot). It must not be the bot openclaw
# already uses — two long-poll consumers on one token steal each other's
# updates. Chat id is your own numeric Telegram id.
SCIG_TELEGRAM_BOT_TOKEN=
SCIG_TELEGRAM_CHAT_ID=8384349643

# ---- Cloudflare R2 ---------------------------------------------------------
# R2 > Manage API tokens > Create token, scoped "Object Read & Write" to the
# one bucket. Account id is in the R2 sidebar.
# PUBLIC_BASE must be publicly readable — Instagram fetches the image itself.
# Prefer a custom domain; the r2.dev subdomain is rate-limited by Cloudflare
# and not intended for production traffic.
SCIG_R2_ACCOUNT_ID=
SCIG_R2_ACCESS_KEY_ID=
SCIG_R2_SECRET_ACCESS_KEY=
SCIG_R2_BUCKET=scientific-chronicles-ig
SCIG_R2_PUBLIC_BASE=https://media.your-domain.com

# ---- Instagram -------------------------------------------------------------
# IG_USER_ID is the Instagram *Business* account id (not the @handle).
# ACCESS_TOKEN is a long-lived token with instagram_business_content_publish.
# It expires after ~60 days — refresh_token.py keeps it alive.
SCIG_IG_USER_ID=
SCIG_IG_ACCESS_TOKEN=
# Bump if Meta retires this Graph API version.
SCIG_IG_API_BASE=https://graph.facebook.com/v23.0
# Needed only by refresh_token.py (Meta app > Settings > Basic).
SCIG_META_APP_ID=
SCIG_META_APP_SECRET=

# ---- Behaviour -------------------------------------------------------------
SCIG_REPO=~/GitHub/scientific-chronicles
SCIG_PUBLISH_AT=17:00
SCIG_MAX_POSTS_PER_DAY=1
SCIG_REPOST_COOLDOWN_DAYS=365
# Include civic/cultural anniversaries (festivals, holidays) as candidates.
SCIG_INCLUDE_OTHER_EVENTS=0

# ---- Images ----------------------------------------------------------------
# Corpus assets in assets/images/ are used first. A few carry third-party
# watermarks from wherever they were originally collected; list those in the
# blocklist and switch the policy to make them fall through to Wikimedia.
#   all (default) | blocklist | allowlist
SCIG_IMAGE_POLICY=all
SCIG_IMAGE_ALLOWLIST=~/.config/sc-instagram/image-allowlist.txt
SCIG_IMAGE_BLOCKLIST=~/.config/sc-instagram/image-blocklist.txt

# ---- Wikimedia portraits ---------------------------------------------------
# When no corpus asset exists, look the person up on Wikipedia and take the
# lead image from Commons. A match is only accepted when the surname matches
# the resolved page title and a known birth/death year appears in the intro —
# a photo of the wrong person is worse than a generated card.
SCIG_WIKIMEDIA=1

# Licences to accept. The render overlays type on the image, which makes a
# derivative work, so share-alike is excluded by default: keeping cc-by-sa
# would oblige you to license the resulting post under CC BY-SA too.
# Add cc-by-sa here if you are comfortable with that.
SCIG_WIKIMEDIA_LICENSES=pd,cc0,cc-by

# Wikimedia asks every client to identify itself. Put a real contact in here.
SCIG_WIKIMEDIA_USER_AGENT=ScientificChronicles/1.0 (https://github.com/ErikPillon/scientific-chronicles)
